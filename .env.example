DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/health_agent
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# 共享开发环境保持 false；仅一次性本地原型可改为 true
AUTO_CREATE_TABLES=false
APP_ENV=development

# DeepSeek Workflow Agent (keep the real key only in local .env)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_ENABLED=true
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_MODEL_REQUESTS=8
AGENT_TIMEOUT_SECONDS=30
